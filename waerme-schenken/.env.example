# Database
DATABASE_URL=postgresql://user:password@localhost:5432/waerme_schenken
DIRECT_URL=postgresql://user:password@localhost:5432/waerme_schenken

# Auth — REQUIRED, app will not start without this
JWT_SECRET=replace-with-a-random-string-at-least-32-characters

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Admin credentials — used for the very first login only.
# Once a password is set via /admin/settings/password it takes priority
# and this value becomes a fallback/recovery credential.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# App URL (used in emails)
APP_URL=https://app.waerme-schenken.ch
